# Copy to .env and fill locally — never commit real secrets.
APP_NAME="Legal Case Summarizer"
ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api

# Phase 3 — OCR (Tesseract 5)
# Language for Tesseract (eng default, add Indic packs like eng+hin as needed)
OCR_LANGUAGE=eng
# Thresholds for conditional OCR gate
OCR_CHAR_THRESHOLD=100
OCR_WORD_THRESHOLD=15
OCR_DPI=300
# Optional: explicit path to tesseract binary if not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# or /usr/bin/tesseract

# Future — leave empty for now
# GEMINI_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3
# SUPABASE_URL=
# SUPABASE_KEY=
