# Copy to .env and fill locally — never commit real secrets.
APP_NAME="Legal Case Summarizer"
ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api

# Phase 3 — OCR (Tesseract 5)
# Language for Tesseract (eng default, add Indic packs like eng+hin as needed)
OCR_LANGUAGE=eng
# Thresholds for conditional OCR gate
OCR_CHAR_THRESHOLD=100
OCR_WORD_THRESHOLD=15
OCR_DPI=300
# Optional: explicit path to tesseract binary if not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# or /usr/bin/tesseract

# Phase B — Supabase Infrastructure
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_DOCUMENTS_BUCKET=legal-case-documents

# Phase C — Auth & JWT Verification (optional overrides)
# SUPABASE_JWT_ALGORITHM=ES256
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# Operational limits (optional overrides)
# MAX_UPLOAD_FILE_SIZE=52428800
# MAX_DOCUMENTS_PER_CASE=20
# MAX_CASE_TOTAL_SIZE=209715200
# SIGNED_URL_EXPIRATION_SECONDS=3600
# GUEST_SESSION_TTL_HOURS=48

# LLM Providers (Phases 7+)
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
